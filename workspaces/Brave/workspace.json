
{
  "description": "Brave is a privacy-focused web browser.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "brave.png",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Browser"
  ],
  "friendly_name": "Brave",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.17.x",
      "image": "kasmweb/brave:1.17.0-rolling-daily", 
      "uncompressed_size_mb": 2500,
      "available_tags": [
        "1.17.0-rolling-daily"
      ]
    }
  ]
}
